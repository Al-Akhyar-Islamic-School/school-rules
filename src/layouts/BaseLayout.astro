---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/units';
import type { UnitSlug } from '../data/units';

interface Props {
  title?: string;
  description?: string;
  unit?: UnitSlug;
}

const { title, description = site.description, unit } = Astro.props;

const pageTitle = title
  ? `${title} · ${site.name} ${site.sekolah}`
  : `${site.name} ${site.sekolah} — TA ${site.tahunAjaran}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-default.png', Astro.site);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#006195" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph — dibaca WhatsApp, Facebook, Telegram saat tautan dibagikan -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.name} ${site.sekolah}`} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title || `${site.name} ${site.sekolah}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title || site.name} />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title || site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data: sekolah -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'School',
        name: site.sekolah,
        description: site.description,
        url: site.webUrl,
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Jl. Arung Teko No. 99, Sudiang, Biringkanaya',
          addressLocality: 'Makassar',
          addressRegion: 'Sulawesi Selatan',
          addressCountry: 'ID',
        },
      })}
    />
  </head>
  <body class="min-h-screen flex flex-col" data-unit={unit}>
    <a
      href="#konten"
      class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:top-2 focus:left-2 focus:bg-white focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-md"
    >
      Lompat ke konten
    </a>
    <Header />
    <main id="konten" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal-on-scroll: elemen [data-reveal] muncul halus saat masuk viewport
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
