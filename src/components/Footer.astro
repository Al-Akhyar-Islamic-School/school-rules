---
import { Image } from 'astro:assets';
import logoWhite from '../assets/logo-sekolah-white.png';
import { site, units } from '../data/units';
const year = new Date().getFullYear();
---

<footer class="bg-primary-700 text-white/80 mt-20">
  <div class="container-ak py-14 grid gap-10 md:grid-cols-4">
    <div class="md:col-span-1">
      <Image src={logoWhite} alt={site.sekolah} width={160} height={90} class="h-12 w-auto mb-4" />
      <p class="text-sm leading-relaxed text-white/70 max-w-xs">
        Peraturan dan tata tertib resmi {site.sekolah} — Tahun Ajaran {site.tahunAjaran}.
      </p>
    </div>

    <div>
      <h3 class="text-white font-semibold text-sm mb-3">Peraturan per Unit</h3>
      <ul class="space-y-2 text-sm">
        {
          units.map((u) => (
            <li>
              <a href={`/${u.slug}/`} class="hover:text-white transition-colors">
                {u.lengkap}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="text-white font-semibold text-sm mb-3">Tautan</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="/tentang/" class="hover:text-white transition-colors">Tentang Peraturan Ini</a></li>
        <li><a href="/dokumen/" class="hover:text-white transition-colors">Dokumen &amp; Surat Pernyataan</a></li>
        <li><a href="/kontak/" class="hover:text-white transition-colors">Kontak &amp; Pengaduan</a></li>
        <li><a href={site.webUrl} target="_blank" rel="noopener" class="hover:text-white transition-colors">Situs Resmi ↗</a></li>
        <li><a href={site.kurikulumUrl} target="_blank" rel="noopener" class="hover:text-white transition-colors">Kurikulum ↗</a></li>
        <li><a href={site.dinarUrl} target="_blank" rel="noopener" class="hover:text-white transition-colors">Dinar App ↗</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-white font-semibold text-sm mb-3">Kontak</h3>
      <ul class="space-y-2 text-sm text-white/70">
        <li>{site.address}</li>
        <li><a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a></li>
        <li><a href={site.whatsapp} target="_blank" rel="noopener" class="hover:text-white">{site.phone} (WhatsApp)</a></li>
        <li><a href={site.instagram} target="_blank" rel="noopener" class="hover:text-white">Instagram {site.instagramHandle}</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-ak py-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-white/50">
      <p>© {year} {site.sekolah}. Semua hak cipta dilindungi.</p>
      <p>Dokumen lengkap tersedia di <a href={site.driveUrl} target="_blank" rel="noopener" class="underline hover:text-white">Google Drive resmi sekolah</a>.</p>
    </div>
  </div>
</footer>
