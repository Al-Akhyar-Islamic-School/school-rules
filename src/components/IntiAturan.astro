---
// Kartu ringkasan "Inti Aturan" — lapisan to-the-point di atas teks lengkap.
// Isi berupa <li> lewat slot.
---

<aside
  class="not-prose rounded-[18px] border-l-4 bg-white shadow-sm p-5 sm:p-6 my-8"
  style="border-left-color: var(--unit); border-top: 1px solid var(--color-slate-200); border-right: 1px solid var(--color-slate-200); border-bottom: 1px solid var(--color-slate-200);"
  aria-label="Inti aturan"
>
  <p class="eyebrow-unit mb-3 flex items-center gap-1.5">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
    </svg>
    Inti Aturan
  </p>
  <ul class="space-y-2.5 text-[15px] leading-relaxed text-slate-700 list-none inti-list">
    <slot />
  </ul>
</aside>

<style>
  .inti-list :global(li) {
    position: relative;
    padding-left: 1.5rem;
  }
  .inti-list :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.42em;
    width: 0.85em;
    height: 0.85em;
    border-radius: 999px;
    background: var(--unit-100);
    border: 2px solid var(--unit);
  }
  .inti-list :global(strong) {
    color: var(--color-ink);
  }
</style>
