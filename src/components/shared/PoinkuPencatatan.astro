---
// Pencatatan proses apresiasi & sanksi di Poinku (Dinar App).
// Dipakai di halaman apresiasi-dan-sanksi unit SD/SMP/SMA.
import PasalHeading from '../PasalHeading.astro';
import Icon from '../Icon.astro';
import type { UnitSlug } from '../../data/units';

interface Props {
  unit: UnitSlug;
}
const { unit } = Astro.props;

const ALUR = [
  {
    t: 'Pelanggaran dicatat di Poinku',
    k: 'Guru atau wali kelas mencatat pelanggaran melalui Dinar App lengkap dengan kategori (ringan/sedang/berat) dan keterangannya.',
  },
  {
    t: 'Poin Akhlak berkurang otomatis',
    k: 'Sistem memotong Poin Akhlak sesuai bobot pelanggaran, dan orang tua menerima notifikasi real-time di Dinar App.',
  },
  {
    t: 'Konsekuensi edukatif dijalankan',
    k: 'Siswa menjalani tahapan pembinaan sesuai tingkat pelanggaran — dari teguran, konseling, hingga sidang kesiswaan untuk kasus berat.',
  },
  {
    t: 'Poin dipulihkan setelah selesai',
    k: 'Penyelesaian konsekuensi edukatif tercatat di Poinku dan Poin Akhlak dapat dipulihkan — pembinaan bertujuan membimbing, bukan sekadar menghukum.',
  },
  {
    t: 'Rekap masuk E-Rapor',
    k: 'Status kartu dan riwayat Poinku menjadi bagian laporan perkembangan peserta didik yang dapat dipantau orang tua kapan saja.',
  },
];
---

<PasalHeading judul="Pencatatan Sanksi dan Apresiasi di Poinku" />
<p>
  Seluruh proses apresiasi dan sanksi berjalan di atas <strong>Poinku — Al Akhyar Student
  Conduct System</strong> yang terintegrasi dengan Dinar App, sehingga setiap tahap
  terdokumentasi, terukur, dan transparan bagi orang tua:
</p>

<ol class="not-prose my-5 space-y-0 list-none poinku-steps">
  {
    ALUR.map((a, i) => (
      <li class="flex gap-4 pb-4 relative">
        <span
          class="w-8 h-8 rounded-full text-white text-[13px] font-bold flex items-center justify-center shrink-0 relative z-10"
          style="background: var(--unit)"
        >
          {i + 1}
        </span>
        <div class="pt-1">
          <p class="font-bold text-ink text-[15px] leading-snug">{a.t}</p>
          <p class="text-[14px] text-slate-500 mt-0.5 leading-relaxed">{a.k}</p>
        </div>
      </li>
    ))
  }
</ol>

<p>
  Prestasi juga dicatat dengan cara yang sama: capaian akademik maupun non-akademik
  menambah <strong>Poin Unggul</strong> siswa dan langsung terlihat oleh orang tua di Dinar App.
</p>

<div class="not-prose grid sm:grid-cols-2 gap-3 my-6">
  <a
    href={`/${unit}/poinku/`}
    class="card-ak p-4 flex items-center gap-3 group"
  >
    <div
      class="w-10 h-10 rounded-[10px] flex items-center justify-center shrink-0"
      style="background: var(--unit-100); color: var(--unit-600);"
    >
      <Icon name="star" size={20} />
    </div>
    <div class="min-w-0">
      <p class="font-semibold text-ink text-[14px] leading-snug group-hover:text-primary-600 transition-colors">Sistem Poinku</p>
      <p class="text-[12.5px] text-slate-500">Status kartu, kategori pelanggaran, dan Poin Unggul</p>
    </div>
  </a>
  <a
    href="https://booklet.alakhyar.sch.id/poinku"
    target="_blank"
    rel="noopener"
    class="card-ak p-4 flex items-center gap-3 group"
  >
    <div
      class="w-10 h-10 rounded-[10px] flex items-center justify-center shrink-0"
      style="background: var(--unit-100); color: var(--unit-600);"
    >
      <Icon name="file-text" size={20} />
    </div>
    <div class="min-w-0">
      <p class="font-semibold text-ink text-[14px] leading-snug group-hover:text-primary-600 transition-colors">Panduan Lengkap Poinku</p>
      <p class="text-[12.5px] text-slate-500">booklet.alakhyar.sch.id/poinku</p>
    </div>
  </a>
</div>

<style>
  .poinku-steps li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 8px;
    bottom: -8px;
    width: 2px;
    background: var(--unit-100);
  }
</style>
