---
import { Image } from 'astro:assets';
import logo from '../assets/logo-mark.png';
import { site, units } from '../data/units';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const navItems = [
  { label: 'Beranda', href: '/' },
  ...units.map((u) => ({ label: u.nama.replace(' Islam', ''), href: `/${u.slug}/` })),
  { label: 'Tentang', href: '/tentang/' },
  { label: 'Kontak', href: '/kontak/' },
];
---

<header class="sticky top-0 z-50 bg-white/85 backdrop-blur-md border-b border-slate-200">
  <div class="container-ak flex items-center justify-between h-16 gap-4">
    <a href="/" class="flex items-center gap-2.5 shrink-0">
      <Image src={logo} alt={site.sekolah} width={96} height={96} class="h-10 w-10" loading="eager" />
      <span class="flex flex-col leading-tight">
        <span class="text-[11px] sm:text-[12px] font-medium text-slate-500 tracking-[0.02em]">{site.sekolah}</span>
        <span class="font-extrabold text-ink text-[14px] sm:text-[15px]">Peraturan Sekolah</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Navigasi utama">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'px-3 py-2 rounded-full text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'text-primary-600 bg-primary-50'
                : 'text-slate-700 hover:text-primary-600 hover:bg-slate-100',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={site.driveUrl}
        target="_blank"
        rel="noopener"
        class="btn btn-primary !py-2 !px-4 text-sm whitespace-nowrap hidden sm:inline-flex"
      >
        Dokumen Lengkap
      </a>
      <button
        id="menu-toggle"
        class="lg:hidden p-2 rounded-lg text-slate-700 hover:bg-slate-100"
        aria-label="Buka menu"
        aria-expanded="false"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-nav" class="lg:hidden hidden border-t border-slate-200 bg-white">
    <nav class="container-ak flex flex-col py-3" aria-label="Navigasi utama (mobile)">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'px-3 py-2.5 rounded-lg text-sm font-medium',
              isActive(item.href) ? 'text-primary-600 bg-primary-50' : 'text-slate-700',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={site.driveUrl}
        target="_blank"
        rel="noopener"
        class="px-3 py-2.5 rounded-lg text-sm font-semibold text-primary-600"
      >
        Dokumen Lengkap (Google Drive) ↗
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!open));
  });
</script>
