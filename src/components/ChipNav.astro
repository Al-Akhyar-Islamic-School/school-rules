---
import type { Unit } from '../data/units';
import { unitPages } from '../data/units';

interface Props {
  unit: Unit;
  activeSlug?: string;
}
const { unit, activeSlug } = Astro.props;
const pages = unitPages(unit);
---

<div class="sticky top-16 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200 no-print">
  <nav class="container-ak py-2.5" aria-label={`Daftar bab peraturan ${unit.nama}`}>
    <div class="chipnav" id="chip-row">
      <a href={`/${unit.slug}/`} aria-current={activeSlug ? undefined : 'page'}>
        {unit.nama.replace(' Islam', '')}
      </a>
      {
        pages.map((p) => (
          <a
            href={`/${unit.slug}/${p.slug}/`}
            aria-current={p.slug === activeSlug ? 'page' : undefined}
          >
            {p.chip}
          </a>
        ))
      }
    </div>
  </nav>
</div>

<script>
  // Gulir otomatis agar chip aktif terlihat (pola dari situs kurikulum)
  const row = document.getElementById('chip-row');
  const active = row?.querySelector<HTMLElement>('[aria-current="page"]');
  if (row && active) row.scrollLeft = active.offsetLeft - 16;
</script>
