---
import RuleLayout from '../../layouts/RuleLayout.astro';
import IntiAturan from '../../components/IntiAturan.astro';
import PoinkuBody from '../../components/shared/PoinkuBody.astro';

const poinUnggul = [
  { capaian: "Melampaui target hafalan Al-Qur'an", poin: '+5 poin' },
  { capaian: 'Juara lomba tingkat sekolah', poin: '+5 poin' },
  { capaian: 'Juara lomba tingkat kota/provinsi', poin: '+10 poin' },
  { capaian: 'Perilaku terpuji yang diakui warga sekolah', poin: '+5 poin' },
  { capaian: 'Tidak pernah absen dalam satu semester', poin: '+5 poin' },
];
---

<RuleLayout unit="sd" slug="poinku">
  <IntiAturan>
    <li>Setiap siswa memulai dengan <strong>Poin Akhlak 100</strong> dan <strong>Poin Unggul 0</strong>.</li>
    <li>Pelanggaran mengurangi Poin Akhlak; prestasi menambah Poin Unggul.</li>
    <li>Status kartu (Green s.d. Black) menentukan bentuk pembinaan yang diterima siswa.</li>
    <li>Semua perubahan poin tercatat di Dinar App dan diberitahukan real-time ke orang tua.</li>
  </IntiAturan>

  <PoinkuBody poinUnggul={poinUnggul} />
</RuleLayout>
